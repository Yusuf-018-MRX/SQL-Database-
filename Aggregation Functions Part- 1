IF DB_ID('Academy') IS NOT NULL
BEGIN
    ALTER DATABASE Academy SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
    DROP DATABASE Academy;
END
GO
CREATE DATABASE Academy;
GO
USE Academy;
GO
CREATE TABLE Faculties
(
    Id INT IDENTITY ( 1 , 1 )  NOT NULL PRIMARY KEY ,
    Name NVARCHAR(100) NOT NULL UNIQUE ,
    CONSTRAINT CK_Faculties_Name CHECK (LEN(Name) > 0)
);
GO

CREATE TABLE Departments
(
    Id INT IDENTITY( 1 , 1 ) NOT NULL PRIMARY KEY ,
    Financing MONEY NOT NULL DEFAULT 0 ,
    Name NVARCHAR( 100 ) NOT NULL UNIQUE ,
    FacultyId INT NOT NULL ,
    CONSTRAINT CK_Departments_Financing CHECK ( Financing >= 0 ) ,
    CONSTRAINT CK_Departments_Name CHECK ( LEN ( Name ) > 0) , 
    CONSTRAINT FK_Departments_Faculties FOREIGN KEY ( FacultyId ) REFERENCES Faculties ( Id )
);
GO

CREATE TABLE Groups
(
    Id INT IDENTITY ( 1 , 1 ) NOT NULL PRIMARY KEY ,
    Name NVARCHAR ( 10 ) NOT NULL UNIQUE ,
    Year INT NOT NULL ,
    DepartmentId INT NOT NULL ,
    StudentsCount INT NOT NULL ,
    CONSTRAINT CK_Groups_Name CHECK ( LEN ( Name ) > 0 ) ,
    CONSTRAINT CK_Groups_Year CHECK ( Year BETWEEN 1 AND 5 ) ,
    CONSTRAINT CK_Groups_StudentsCount CHECK ( StudentsCount >= 0 ) ,
    CONSTRAINT FK_Groups_Departments FOREIGN KEY ( DepartmentId ) REFERENCES Departments ( Id )
);
GO
CREATE TABLE Subjects
(
    Id INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    Name NVARCHAR(100) NOT NULL UNIQUE,
    CONSTRAINT CK_Subjects_Name CHECK (LEN(Name) > 0)
);
GO
CREATE TABLE Teachers
(
    Id INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    Name NVARCHAR(MAX) NOT NULL,
    Salary MONEY NOT NULL,
    Surname NVARCHAR(MAX) NOT NULL,
    CONSTRAINT CK_Teachers_Name CHECK (LEN(Name) > 0),
    CONSTRAINT CK_Teachers_Salary CHECK (Salary > 0),
    CONSTRAINT CK_Teachers_Surname CHECK (LEN(Surname) > 0)
);
GO
CREATE TABLE Lectures
(
    Id INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    DayOfWeek INT NOT NULL,
    LectureRoom NVARCHAR(MAX) NOT NULL,
    SubjectId INT NOT NULL,
    TeacherId INT NOT NULL,
    CONSTRAINT CK_Lectures_DayOfWeek CHECK (DayOfWeek BETWEEN 1 AND 7),
    CONSTRAINT CK_Lectures_LectureRoom CHECK (LEN(LectureRoom) > 0),
    CONSTRAINT FK_Lectures_Subjects FOREIGN KEY (SubjectId) REFERENCES Subjects(Id),
    CONSTRAINT FK_Lectures_Teachers FOREIGN KEY (TeacherId) REFERENCES Teachers(Id)
);
GO
CREATE TABLE GroupsLectures
(
    Id INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    GroupId INT NOT NULL,
    LectureId INT NOT NULL,
    CONSTRAINT FK_GroupsLectures_Groups  FOREIGN KEY (GroupId) REFERENCES Groups(Id),
    CONSTRAINT FK_GroupsLectures_Lectures  FOREIGN KEY (LectureId) REFERENCES Lectures(Id),
    CONSTRAINT UQ_GroupsLectures_GroupLecture UNIQUE (GroupId, LectureId)
);
GO
